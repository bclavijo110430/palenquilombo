---
import '@fontsource-variable/inter';
import '@fontsource-variable/oswald';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { SITE, asset } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(asset('og-default.webp'), Astro.site);
const homeUrl = new URL(asset(''), Astro.site);
const ptUrl = new URL(asset('pt/'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17130f" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" href={asset('favicon-96.png')} sizes="96x96" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

    <link rel="alternate" hreflang="es" href={homeUrl} />
    <link rel="alternate" hreflang="pt" href={ptUrl} />
    <link rel="alternate" hreflang="x-default" href={homeUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'es_CO'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'pt' ? 'Pular para o conteúdo' : 'Saltar al contenido'}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    z-index: 200;
    background: var(--c-terracotta-dark);
    color: #fff;
    padding: 0.75rem 1.15rem;
    border-radius: 0 0 10px 10px;
    transition: top var(--transition);
  }
  .skip-link:focus {
    top: 0;
  }
</style>
