---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/entreno-*.webp', {
  eager: true,
});
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    ...mod.default,
    name: path.split('/').pop()?.replace('.webp', '') ?? '',
  }));
---

<section class="section gallery" id="gallery">
  <div class="container">
    <span class="eyebrow">{t.gallery.eyebrow}</span>
    <h2 class="section__title">{t.gallery.title}</h2>
    <p class="section__lead">{t.gallery.lead}</p>

    <ul class="gallery__grid">
      {
        photos.map((photo, i) => (
          <li class="gallery__item">
            <button
              class="gallery__btn"
              type="button"
              data-index={i}
              data-full={photo.src}
              aria-label={`${t.gallery.open}: ${photo.name}`}
            >
              <Image
                src={photo}
                alt=""
                widths={[360, 640, 900]}
                sizes="(min-width: 900px) 30vw, (min-width: 560px) 45vw, 92vw"
                loading="lazy"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lightbox" id="lightbox" aria-label={t.gallery.title}>
  <button class="lightbox__close" type="button" id="lb-close" aria-label={t.gallery.close}>
    &times;
  </button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" id="lb-prev" aria-label={t.gallery.prev}>
    &#8249;
  </button>
  <img class="lightbox__img" id="lb-img" alt="" />
  <button class="lightbox__nav lightbox__nav--next" type="button" id="lb-next" aria-label={t.gallery.next}>
    &#8250;
  </button>
</dialog>

<style>
  .gallery__grid {
    list-style: none;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    columns: 1;
    column-gap: 1rem;
  }

  .gallery__item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .gallery__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .gallery__btn :global(img) {
    width: 100%;
    height: auto;
    transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .gallery__btn:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .gallery__btn:hover :global(img) {
    transform: scale(1.04);
  }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(12, 9, 7, 0.92);
    backdrop-filter: blur(4px);
  }

  .lightbox__img {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: min(96vw, 1200px);
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
  }

  .lightbox__close {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
    z-index: 2;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--c-border-dark);
    background: rgba(23, 19, 15, 0.7);
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    display: grid;
    place-items: center;
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--c-border-dark);
    background: rgba(23, 19, 15, 0.7);
    color: #fff;
    font-size: 2.1rem;
    line-height: 1;
    display: grid;
    place-items: center;
  }

  .lightbox__nav--prev {
    left: max(0.75rem, env(safe-area-inset-left));
  }

  .lightbox__nav--next {
    right: max(0.75rem, env(safe-area-inset-right));
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: var(--c-terracotta-dark);
  }

  @media (min-width: 560px) {
    .gallery__grid {
      columns: 2;
    }
  }

  @media (min-width: 960px) {
    .gallery__grid {
      columns: 3;
      column-gap: 1.25rem;
    }
    .gallery__item {
      margin-bottom: 1.25rem;
    }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.gallery__btn')
  );
  let current = 0;

  const render = () => {
    const btn = buttons[current];
    if (!btn || !img) return;
    img.src = btn.dataset.full || '';
    img.alt = btn.querySelector('img')?.alt || '';
  };

  const open = (index: number) => {
    current = index;
    render();
    dialog?.showModal();
  };

  const move = (delta: number) => {
    current = (current + delta + buttons.length) % buttons.length;
    render();
  };

  buttons.forEach((btn, i) => btn.addEventListener('click', () => open(i)));

  document.getElementById('lb-close')?.addEventListener('click', () => dialog?.close());
  document.getElementById('lb-prev')?.addEventListener('click', () => move(-1));
  document.getElementById('lb-next')?.addEventListener('click', () => move(1));

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') move(-1);
    if (event.key === 'ArrowRight') move(1);
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog?.close();
  });
</script>
