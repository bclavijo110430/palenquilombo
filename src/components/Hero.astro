---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photos/entreno-05.webp';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { whatsappLink } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const waHref = whatsappLink(t.whatsapp.message);
---

<section class="hero" id="inicio">
  <Image
    class="hero__bg"
    src={heroPhoto}
    alt="Grupo de Palenquilombo Capoeira reunido en la roda en Bogotá"
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__scrim"></div>

  <div class="container hero__inner">
    <p class="hero__badge">
      <span class="hero__badge-dot"></span>
      {t.hero.badge}
    </p>
    <span class="eyebrow hero__eyebrow">{t.hero.eyebrow}</span>
    <h1 class="hero__title">{t.hero.title}</h1>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener">{t.hero.ctaPrimary}</a>
      <a class="btn btn--ghost hero__ghost" href="#schedule">{t.hero.ctaSecondary}</a>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label={t.about.title}>
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(23, 19, 15, 0.68) 0%, rgba(23, 19, 15, 0.35) 42%, rgba(23, 19, 15, 0.92) 100%),
      radial-gradient(120% 80% at 78% 18%, rgba(192, 90, 54, 0.34), transparent 60%);
  }

  .hero__inner {
    position: relative;
    padding-bottom: clamp(4.5rem, 12vh, 8rem);
    padding-top: calc(var(--header-h) + 3rem);
    max-width: 56rem;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: var(--font-display);
    color: var(--c-text-on-dark);
    background: rgba(23, 19, 15, 0.5);
    border: 1px solid var(--c-border-dark);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    margin: 0 0 1.1rem;
    backdrop-filter: blur(6px);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-terracotta-light);
    box-shadow: 0 0 0 4px rgba(211, 95, 48, 0.28);
  }

  .hero__eyebrow {
    color: var(--c-cream);
    font-size: 0.8rem;
  }

  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 8.5vw, 6rem);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-top: 0.5rem;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45);
  }

  .hero__subtitle {
    margin: 1.1rem 0 0;
    max-width: 46ch;
    font-size: clamp(1.02rem, 0.96rem + 0.4vw, 1.25rem);
    color: var(--c-text-on-dark);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .hero__ghost {
    color: #fff;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    display: none;
    place-items: center;
  }

  .hero__scroll span {
    width: 3px;
    height: 8px;
    border-radius: 3px;
    background: #fff;
    animation: scroll-dot 1.6s infinite;
  }

  @keyframes scroll-dot {
    0% {
      transform: translateY(-7px);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    80% {
      transform: translateY(8px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (min-width: 640px) {
    .hero__scroll {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll span {
      animation: none;
    }
  }
</style>
