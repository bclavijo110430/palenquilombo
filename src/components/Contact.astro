---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { SITE, SCHEDULE, whatsappLink } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socials = [
  { key: 'whatsapp', label: t.contact.whatsapp, href: whatsappLink(t.whatsapp.message) },
  { key: 'instagram', label: t.contact.instagram, href: SITE.instagram },
  { key: 'email', label: t.contact.email, href: SITE.email ? `mailto:${SITE.email}` : '' },
];
---

<section class="section section--dark contact" id="contact">
  <div class="container contact__grid">
    <div class="contact__info">
      <span class="eyebrow">{t.contact.eyebrow}</span>
      <h2 class="section__title">{t.contact.title}</h2>
      <p class="section__lead">{t.contact.lead}</p>

      <ul class="contact__list">
        <li>
          <span class="contact__label">{t.contact.addressLabel}</span>
          <span class="contact__value">{SITE.address}</span>
          <span class="contact__sub">{t.contact.city}</span>
        </li>
        {
          SCHEDULE.map((slot) => (
            <li>
              <span class="contact__label">{t.schedule.days[slot.dayKey]}</span>
              <span class="contact__value">{slot.time}</span>
            </li>
          ))
        }
      </ul>

      <div class="contact__social">
        <span class="contact__label">{t.contact.socialTitle}</span>
        <div class="socials">
          {
            socials.map((social) =>
              social.href ? (
                <a class="social" href={social.href} target="_blank" rel="noopener">
                  {social.label}
                </a>
              ) : (
                <span class="social social--disabled" aria-disabled="true" title={t.contact.soon}>
                  {social.label}
                  <em>{t.contact.soon}</em>
                </span>
              )
            )
          }
        </div>
      </div>

      <div class="contact__actions">
        <a
          class="btn btn--whatsapp contact__cta"
          href={whatsappLink(t.whatsapp.message)}
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path
              d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.02ZM12.05 20.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.23 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.39 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"
            ></path>
          </svg>
          {t.whatsapp.label}
        </a>
        <a class="btn btn--ghost contact__cta" href={SITE.mapLink} target="_blank" rel="noopener">
          {t.contact.mapLabel}
        </a>
      </div>
    </div>

    <div class="contact__map">
      <iframe
        src={SITE.mapEmbed}
        title={t.contact.mapTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .contact__list {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .contact__list li {
    display: flex;
    flex-direction: column;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-border-dark);
  }

  .contact__label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    color: var(--c-terracotta-light);
  }

  .contact__value {
    font-size: 1.15rem;
    color: var(--c-text-on-dark);
  }

  .contact__sub {
    color: var(--c-text-on-dark-muted);
    font-size: 0.95rem;
  }

  .contact__social {
    margin-top: 1.75rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--c-border-dark);
    font-size: 0.9rem;
    color: var(--c-text-on-dark);
    transition: border-color var(--transition), background var(--transition);
  }

  a.social:hover {
    border-color: var(--c-terracotta);
    background: rgba(192, 90, 54, 0.18);
  }

  .social--disabled {
    opacity: 0.65;
  }

  .social--disabled em {
    font-style: normal;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-text-on-dark-muted);
  }

  .contact__cta {
    margin-top: 0;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .contact__map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--c-border-dark);
    box-shadow: var(--shadow-lg);
    background: var(--c-ink-soft);
    aspect-ratio: 4 / 3;
  }

  .contact__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.15) contrast(1.02);
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr 1.05fr;
    }
    .contact__map {
      aspect-ratio: 1 / 1;
    }
  }
</style>
