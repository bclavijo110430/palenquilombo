---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { asset } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const videos = [
  { src: asset('videos/showcase-01.mp4'), poster: asset('videos/showcase-01-poster.webp'), ratio: '9 / 16' },
  { src: asset('videos/showcase-02.mp4'), poster: asset('videos/showcase-02-poster.webp'), ratio: '16 / 9' },
  { src: asset('videos/showcase-03.mp4'), poster: asset('videos/showcase-03-poster.webp'), ratio: '16 / 9' },
];
---

<section class="section section--dark videos" id="videos">
  <div class="container">
    <span class="eyebrow">{t.videos.eyebrow}</span>
    <h2 class="section__title">{t.videos.title}</h2>
    <p class="section__lead">{t.videos.lead}</p>

    <div class="videos__grid">
      {
        videos.map((video, i) => (
          <figure class={`video-card ${i === 0 ? 'video-card--tall' : ''}`} style={`--ratio: ${video.ratio}`}>
            <button
              class="video-card__play"
              type="button"
              data-src={video.src}
              aria-label={`${t.videos.play}`}
            >
              <img src={video.poster} alt="" width="1280" height="720" loading="lazy" />
              <span class="video-card__cta">
                <span class="video-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
                <span class="video-card__label">{t.videos.play}</span>
              </span>
            </button>
          </figure>
        ))
      }
    </div>
    <p class="videos__note">{t.videos.note}</p>
  </div>
</section>

<style>
  .videos__grid {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }

  .video-card {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-lg);
  }

  .video-card__play {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    aspect-ratio: var(--ratio, 16 / 9);
  }

  .video-card__play img,
  .video-card__play video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-card__play::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(12, 9, 7, 0.7));
    transition: opacity var(--transition);
  }

  .video-card__play:hover::after {
    opacity: 0.7;
  }

  .video-card__cta {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem 0.6rem 0.65rem;
    border-radius: 999px;
    background: rgba(23, 19, 15, 0.62);
    border: 1px solid var(--c-border-dark);
    color: #fff;
    backdrop-filter: blur(6px);
    transition: background var(--transition), transform var(--transition);
  }

  .video-card__play:hover .video-card__cta {
    background: var(--c-terracotta-dark);
    transform: translate(-50%, -50%) scale(1.04);
  }

  .video-card__icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--c-terracotta);
    display: grid;
    place-items: center;
    flex: none;
  }

  .video-card__label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.82rem;
  }

  .videos__note {
    margin-top: 1rem;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--c-text-on-dark-muted);
    text-align: center;
  }

  @media (min-width: 860px) {
    .videos__grid {
      grid-template-columns: 0.85fr 1fr;
      grid-template-rows: auto auto;
    }
    .video-card--tall {
      grid-row: span 2;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-card__play').forEach((button) => {
    button.addEventListener(
      'click',
      () => {
        const src = button.dataset.src;
        if (!src) return;
        const video = document.createElement('video');
        video.src = src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.setAttribute('preload', 'metadata');
        button.replaceWith(video);
        video.play().catch(() => {});
      },
      { once: true }
    );
  });
</script>
