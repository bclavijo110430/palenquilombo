---
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/photos/entreno-02.webp';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section about" id="about">
  <div class="container about__grid">
    <div class="about__text">
      <span class="eyebrow">{t.about.eyebrow}</span>
      <h2 class="section__title">{t.about.title}</h2>
      <p class="section__lead">{t.about.lead}</p>
      {
        t.about.paragraphs.map((paragraph) => (
          <p class="about__paragraph">{paragraph}</p>
        ))
      }
    </div>

    <div class="about__media">
      <Image
        class="about__img"
        src={aboutPhoto}
        alt="Entreno de Palenquilombo Capoeira"
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 44vw, 92vw"
        loading="lazy"
      />
      <span class="about__mark">Axé</span>
    </div>
  </div>

  <div class="container">
    <ul class="values">
      {
        t.about.values.map((value, i) => (
          <li class="value">
            <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .about__paragraph {
    margin-top: 1rem;
    color: var(--c-text-muted);
  }

  .about__media {
    position: relative;
  }

  .about__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__mark {
    position: absolute;
    top: -0.9rem;
    left: -0.6rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    background: var(--c-terracotta-dark);
    color: #fff;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transform: rotate(-6deg);
    box-shadow: var(--shadow-sm);
  }

  .values {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .value {
    position: relative;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 1.5rem 1.4rem 1.4rem;
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .value::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(var(--c-terracotta), var(--c-red));
  }

  .value:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .value__num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: var(--c-terracotta);
  }

  .value h3 {
    font-size: 1.35rem;
    text-transform: uppercase;
    margin: 0.35rem 0 0.5rem;
  }

  .value p {
    margin: 0;
    color: var(--c-text-muted);
    font-size: 0.97rem;
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
    .values {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
